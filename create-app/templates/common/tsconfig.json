{
  "compilerOptions": {
    "outDir": "built",
    "rootDir": "./src",
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "declarationMap": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["es2022"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "built"]
}
