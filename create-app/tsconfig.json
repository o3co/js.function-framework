{
  "compilerOptions": {
    "outDir": "./built",
    "rootDir": "./src",
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "built", "templates"]
}
