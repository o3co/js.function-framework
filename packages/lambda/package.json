    "node": ">=22.0.0"
  },
  "dependencies": {
    "@o3co/js.function-framework.core": "^0.2.4",
    "@o3co/js.util.promise": "0.4.8",
    "@types/aws-lambda": "^8.10.160",
    "deepmerge": "4.3.1"
  }
}
